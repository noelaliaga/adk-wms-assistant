# Copy to .env (never commit it) or export these in your shell.
# The ADK CLI also reads a .env file next to the agent (agents/wms_assistant/.env).

# --- Model: Gemini (default) -------------------------------------------------
# Either an API key from Google AI Studio ...
GOOGLE_API_KEY=
# ... or Vertex AI with Application Default Credentials:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=europe-west1
# WMS_MODEL=            # optional; defaults to ADK's default Gemini model

# --- Model: Claude or OpenAI through LiteLLM ---------------------------------
# WMS_MODEL_BACKEND=litellm
# WMS_MODEL=anthropic/<model-id>     # or openai/<model-id>
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Warehouse ----------------------------------------------------------------
WMS_WRITE_POLICY=off          # off | dry_run | on  (writes always need your approval)
WMS_DB_PATH=data/wms.sqlite   # created by `make seed`
# WMS_MCP_COMMAND=/path/to/mcp-logistica/.venv/bin/wms-mcp
# WMS_MCP_TIMEOUT_S=30
