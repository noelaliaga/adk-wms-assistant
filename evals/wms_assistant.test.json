{
  "eval_set_id": "wms_assistant_read_only",
  "name": "WMS assistant: read paths and ask-before-assuming",
  "description": "Synthetic cases against the mcp-logistica seed database, run with WMS_WRITE_POLICY=off. Reference answers are hand-written, not recorded from a model. One case has two turns (ask, then act on the id the user gives).",
  "eval_cases": [
    {
      "eval_id": "stalled_orders_48h",
      "conversation": [
        {
          "invocation_id": "stalled_orders_48h-1",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "Which orders have been in the warehouse for more than 48 hours without shipping?"
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Six orders are older than 48 hours and have not shipped: 10420 (stock_issue), 10409 (pending), 10423 (address_issue), 10412 (allocated), 10417 (picking) and 10426 (packed)."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "list_stalled_orders",
                "args": {
                  "min_hours": 48
                }
              }
            ],
            "tool_responses": [],
            "intermediate_responses": []
          }
        }
      ],
      "session_input": {
        "app_name": "wms_assistant",
        "user_id": "eval-user",
        "state": {}
      },
      "rubrics": [
        {
          "rubric_id": "stalled_orders_48h-1",
          "rubric_content": {
            "text_property": "The response lists exactly these order ids: 10420, 10409, 10423, 10412, 10417 and 10426."
          },
          "type": "FINAL_RESPONSE_QUALITY"
        },
        {
          "rubric_id": "stalled_orders_48h-2",
          "rubric_content": {
            "text_property": "The response does not list any shipped, delivered or cancelled order."
          },
          "type": "FINAL_RESPONSE_QUALITY"
        }
      ]
    },
